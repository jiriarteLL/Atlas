# Normalización de line endings
# Los archivos de texto se guardan con LF en el repo y se checkoutean con LF en el working tree.
# Evita drift CRLF/LF entre Windows, WSL y Linux.

* text=auto eol=lf

# Binarios explícitos (no normalizar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary

# Scripts shell: siempre LF (ejecutables en contenedores Linux)
*.sh text eol=lf
*.bash text eol=lf

# Windows-specific: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
