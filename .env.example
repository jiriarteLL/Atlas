# .env.example — Inventario LLYA v2. Copiar a .env y completar. El .env real NUNCA se commitea.
# Secretos NUEVOS por ambiente (dev / test / preprod): no reutilizar los de produccion ni entre ambientes.
# Los secretos van VACIOS aca: sin completarlos la app no arranca (JWT_SECRET/DATABASE_URL) o el seeder falla.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"

# ── APP ──
APP_NAME=inventario
APP_ID=1
# Puerto publicado en el host. Dev local: 3100 (APP_ID=1). Test/Preprod: del rango del ambiente, verificado libre.
APP_PORT=3100
# URL publica del ambiente (links en los mails). Ej.: http://10.100.1.124:31x0
APP_URL=
# Origenes permitidos por CORS, separados por coma. Vacio = mismo origen (recomendado).
CORS_ORIGINS=

# ── DB (PostgreSQL) ──
DB_NAME=inventario
DB_USER=inventario
# Solo caracteres [A-Za-z0-9] (va dentro de DATABASE_URL). Usar token_hex.
DB_PASSWORD=

# ── AUTH ──
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
BCRYPT_COST=12
LOGIN_RATE_LIMIT=5/minute

# ── MAESTRO ──
MAESTRO_API_KEY=
MAESTRO_WEBHOOK_SECRET=
COMPANY_NAME=Lisicki, Litvin & Abelovich
# Vacio = /logo.png servido por la app
COMPANY_LOGO_URL=
COMPANY_PRIMARY_COLOR=#0B7285

# ── SEEDING ──
# admin@llyasoc.com. Minimo 12 caracteres y 3 de: minusculas, mayusculas, numeros, simbolos.
SUPERADMIN_INITIAL_PASSWORD=

# ── AGENTES DE INVENTARIO ──
# Clave que mandan los agentes en el header X-Sync-Key (POST /api/sync y /api/sync-glpi).
SYNC_API_KEY=

# ── TENDENCIAS ──
# Dias entre snapshots automaticos (0 = desactivado)
SNAPSHOT_DIAS=7

# ── SMTP (opcional: sin SMTP_HOST no se envian mails) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inventario LLYA
SMTP_DOMINIO=llyasoc.com
