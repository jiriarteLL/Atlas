# ============================================================
# .env.example — Inventario LLYA v2 (app huesped, contrato maestro.platform/v2)
# ============================================================
# Copiar a .env y completar:  cp .env.example .env
# El .env real NUNCA se commitea (SE-009).
# Secretos NUEVOS por ambiente (dev / test / preprod): no reutilizar los de produccion ni entre ambientes.
# Los secretos van VACIOS aca: sin completarlos la app no arranca (JWT_SECRET / DATABASE_URL) o el seeder falla.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
#
# NUNCA loguear: passwords, hashes, JWTs, cookies de sesion, MAESTRO_API_KEY, MAESTRO_WEBHOOK_SECRET,
# JWT_SECRET, SUPERADMIN_INITIAL_PASSWORD (CONVENCIONES §10.2). La app ya los excluye de sus logs.
# ============================================================

# ── APP ──
APP_ID=1
APP_NAME=inventario
# Puerto publicado en el host. Dev local: 3100 (APP_ID=1, README §5).
# Test/Preprod en Dokploy: del rango del ambiente, verificado libre (MANUAL §2). NO se deduce del APP_ID.
APP_PORT=3100
# Puerto interno del contenedor (= maestro.yaml requires.ports.app = EXPOSE). Informativo: no cambiar.
APP_INTERNAL_PORT=8000
# local | staging | production (CONVENCIONES §6.1). Los compose lo fijan por ambiente.
APP_ENV=local
# URL publica del ambiente (links de mails y de /maestro/branding). Ej.: http://10.100.1.124:31x0
APP_URL=
# Origenes permitidos por CORS, separados por coma. Vacio = mismo origen (recomendado).
CORS_ORIGINS=
# IPs de proxies de confianza para X-Forwarded-For (uvicorn). Detras de Traefik: la red del proxy o *.
FORWARDED_ALLOW_IPS=127.0.0.1
COMPANY_NAME=Lisicki, Litvin & Abelovich

# ── DB (PostgreSQL; = maestro.yaml requires.database) ──
# El Maestro inyecta DATABASE_URL (postgres://...). En los compose se arma con estas tres:
DB_NAME=inventario
DB_USER=inventario
# Solo caracteres [A-Za-z0-9] (va dentro de DATABASE_URL). Usar token_hex.
DB_PASSWORD=

# ── AUTH (v4) ──
JWT_SECRET=
BCRYPT_COST=12
# Access token corto + refresh token (SPEC §2.4.2). Formato: 15m, 12h, 30d.
TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h
# Bandera Secure de la cookie de sesion (inventario_session). false SOLO mientras el ambiente sea HTTP
# (Test/Preprod en Dokploy, MANUAL §6.4). Con HTTPS: true.
COOKIES_SEGURAS=false
# Login: intentos por minuto por IP y por hora por email (ademas: bloqueo de 15 min tras 5 fallos).
LOGIN_RATE_LIMIT_PER_IP=5
LOGIN_RATE_LIMIT_PER_EMAIL=10

# ── MAESTRO (v4) — los inyecta el Maestro en produccion ──
# Secret compartido para /maestro/branding y /metrics (header X-Maestro-Api-Key). Rotacion: 90 dias.
MAESTRO_API_KEY=
# Solo si la app declara hooks en maestro.yaml (hoy no declara ninguno).
MAESTRO_WEBHOOK_SECRET=
MAESTRO_BASE_URL=
MAESTRO_DEPLOYMENT_ID=
# Vacio = /logo.png servido por la app
COMPANY_LOGO_URL=
COMPANY_PRIMARY_COLOR=#0B7285

# ── SEEDING (v4) ──
# Password inicial de admin@llyasoc.com. OBLIGATORIA: >= 12 caracteres y 3 de: minusculas, mayusculas,
# numeros, simbolos; no comun. La app obliga a cambiarla en el primer ingreso.
SUPERADMIN_INITIAL_PASSWORD=

# ── AGENTES DE INVENTARIO ──
# Clave que mandan los agentes en el header X-Sync-Key (POST /api/sync y /api/sync-glpi).
SYNC_API_KEY=

# ── TENDENCIAS ──
# Dias entre snapshots automaticos (0 = desactivado)
SNAPSHOT_DIAS=7

# ── LOGGING (CONVENCIONES §10) ──
# debug | info | warn | error
LOG_LEVEL=info
# json (produccion, obligatorio) | text (solo para leer a mano en dev)
LOG_FORMAT=json

# ── SMTP (opcional: sin SMTP_HOST no se envian mails) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inventario LLYA
SMTP_DOMINIO=llyasoc.com
