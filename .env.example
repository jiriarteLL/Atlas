# ============================================================
# PLATAFORMA MAESTRO v2 — Variables de Entorno
# Framework agentico v4 / contrato maestro.platform/v2
# ============================================================
# Copiar este archivo a .env y ajustar los valores:
#   cp .env.example .env
#
# NUNCA commitear .env al repositorio.
# Este archivo (.env.example) SI se commitea como referencia.
# ============================================================
#
# CAMBIO IMPORTANTE v3 -> v4:
# - Se ELIMINO la seccion MOCK (auth ahora es propia de cada app, no por headers).
# - Se AGREGARON: JWT_SECRET, BCRYPT_COST, MAESTRO_API_KEY,
#   MAESTRO_WEBHOOK_SECRET, SUPERADMIN_INITIAL_PASSWORD.
# - Single-tenant fisico: cada deployment de app sirve a UNA empresa.
# ============================================================


# ────────────────────────────────────────────────────────────
# APP — Identificacion y puertos
# ────────────────────────────────────────────────────────────

# ID unico de la aplicacion (coordinar con el administrador).
# Determina los puertos asignados. Ver tabla en README seccion 5.
# Formula: APP_PORT = 3000 + (APP_ID x 100)
APP_ID=1

# Nombre slug de la app (lowercase, sin espacios, sin caracteres especiales).
# Se usa en nombres de contenedores, redes y volumenes Docker.
APP_NAME=inventario

# Puerto EXTERNO donde la app es accesible desde el host.
# Calculado: 3000 + (APP_ID x 100)
APP_PORT=3100

# Puerto INTERNO que tu app escucha dentro del contenedor.
# Node.js (Express): 3000  |  Python (FastAPI/Flask): 8000
# PHP (Laravel): 8000      |  Java (Spring Boot): 8080
# Go (Gin/Fiber): 8080     |  .NET (ASP.NET): 5000
# Ruby (Rails): 3000       |  Rust (Actix): 8080
APP_INTERNAL_PORT=3000

# Entorno de ejecucion: development | staging | production
APP_ENV=development

# Identificador legible de la empresa que opera este deployment (single-tenant fisico).
# Se usa en logs y en /maestro/branding como company_name por default.
# En produccion el Maestro v2 inyecta el valor real al provisionar el deployment.
COMPANY_NAME=Empresa Demo


# ────────────────────────────────────────────────────────────
# DB — Base de datos
# ────────────────────────────────────────────────────────────

# Motor: postgres | mysql | mongo | sqlite | none
# Debe coincidir con maestro.yaml -> requires.database
DB_ENGINE=postgres

# Imagen Docker:
#   postgres -> postgres:16-alpine
#   mysql    -> mysql:8.0
#   mongo    -> mongo:7
DB_IMAGE=postgres:16-alpine

# Driver para la URL de conexion:
#   postgres -> postgresql
#   mysql    -> mysql
#   mongo    -> mongodb
DB_DRIVER=postgresql

# Puerto interno del motor de BD.
# postgres: 5432  |  mysql: 3306  |  mongo: 27017
DB_PORT_INTERNAL=5432

# Nombre, usuario y password de la BD.
DB_NAME=app-inventario
DB_USER=app-inventario
DB_PASSWORD=cambiar_en_dev_aleatorio_en_prod

# Exponer puerto de la BD al host para debug (DBeaver, pgAdmin).
# false: solo accesible dentro de la red Docker.
# true:  expone en DB_DEBUG_PORT (solo dev).
DB_EXPOSE_PORT=false
DB_DEBUG_PORT=3101


# ────────────────────────────────────────────────────────────
# AUTH (v4) — Login propio de la app
# ────────────────────────────────────────────────────────────
# La app valida usuarios contra su tabla `users`. NO recibe
# headers X-Auth-* del Maestro (modelo deprecado v3).
# ────────────────────────────────────────────────────────────

# Secret para firmar tokens JWT propios de la app (si usas JWT).
# Generar con: openssl rand -base64 48
# JAMAS commitear el valor real.
JWT_SECRET=cambiar_a_un_secret_largo_aleatorio

# Secret de sesion (si usas cookies con express-session, Laravel session, Django, etc.).
# Generar con: openssl rand -base64 48
SESSION_SECRET=cambiar_a_un_secret_largo_aleatorio

# Cost de bcrypt (>=12 obligatorio segun preset v4).
# Si usas argon2id en lugar de bcrypt, omitir esta y configurar
# argon2 con memory >=32MB, iterations >=3, parallelism >=1.
BCRYPT_COST=12

# Tiempo de vida del token de acceso (formato segun lib).
# Recomendado: corto + refresh tokens. Ej: '15m' (jsonwebtoken).
TOKEN_TTL=15m

# Tiempo de vida del refresh token. Ej: '30d'.
REFRESH_TOKEN_TTL=30d


# ────────────────────────────────────────────────────────────
# MAESTRO INTEGRATION (v4) — Server-to-server
# ────────────────────────────────────────────────────────────
# Estos secrets autentican llamadas del Maestro v2 a tu app.
# El Maestro v2 los inyecta en produccion. En dev son ficticios
# pero deben existir para que la app arranque.
# ────────────────────────────────────────────────────────────

# Secret compartido entre Maestro v2 y esta app, usado para
# autenticar el consumo del endpoint /maestro/branding.
# Generar con: openssl rand -base64 32
# Rotacion recomendada: cada 90 dias.
MAESTRO_API_KEY=cambiar_a_un_secret_aleatorio_en_dev

# Secret HMAC-SHA256 para verificar webhooks entrantes del Maestro
# (si la app declara hooks en maestro.yaml).
# Generar con: openssl rand -base64 32
MAESTRO_WEBHOOK_SECRET=cambiar_a_un_secret_aleatorio_en_dev

# URL base del Maestro v2. En dev puede no existir todavia
# (apps v4 funcionan standalone). En prod la inyecta el Maestro.
MAESTRO_BASE_URL=

# UUID del deployment asignado por el Maestro v2 al provisionar.
# En dev: cualquier valor o vacio. En prod: lo inyecta el Maestro.
MAESTRO_DEPLOYMENT_ID=local-dev


# ────────────────────────────────────────────────────────────
# SEEDING (v4) — Fase 05-seeding del framework agentico
# ────────────────────────────────────────────────────────────
# El seeder crea (idempotente) el usuario superadmin
# admin@llyasoc.com con rol superadmin.
# Si esta variable falta o es debil, el seeder falla con exit != 0.
# ────────────────────────────────────────────────────────────

# Password inicial del superadmin admin@llyasoc.com.
# OBLIGATORIA. Minimo 12 chars. No usar comunes (admin, password, 12345).
# Generar con: openssl rand -base64 24
# El usuario debe cambiarla despues del primer login (recomendado).
SUPERADMIN_INITIAL_PASSWORD=cambiar_a_password_fuerte_de_24_chars

# (Opcional) Passwords iniciales para usuarios adicionales sembrados.
# Solo si maestro.yaml declara seeding.additional_users.
# Patron: <ROLE>_INITIAL_PASSWORD (en mayusculas).
# Ejemplo:
#   EDITOR_INITIAL_PASSWORD=cambiar_a_password_fuerte
#   VIEWER_INITIAL_PASSWORD=cambiar_a_password_fuerte


# ────────────────────────────────────────────────────────────
# RATE LIMITING (recomendado v4)
# ────────────────────────────────────────────────────────────

# Limite de intentos en /login por IP por minuto.
LOGIN_RATE_LIMIT_PER_IP=5

# Limite de intentos en /login por email por hora.
LOGIN_RATE_LIMIT_PER_EMAIL=10


# ────────────────────────────────────────────────────────────
# REDIS — Cache y colas (opcional)
# ────────────────────────────────────────────────────────────
# Descomentar si tu app necesita Redis y descomentar el servicio
# en docker-compose.yml.

# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=cambiar_en_dev


# ────────────────────────────────────────────────────────────
# TAILWISE — Sistema de diseno
# ────────────────────────────────────────────────────────────

# Theme: dagger, echo, exort, havoc, hook, hurricane, ravage,
#        raze, razor, shuriken, viper.
TAILWISE_THEME=echo

# Version de Tailwise usada.
# "HTML Version - v1.0.1", "Laravel Version - v1.0.3",
# "React Version - v1.0.9", "Tailwise Vue - v1.0.1"
TAILWISE_VERSION=React Version - v1.0.9


# ────────────────────────────────────────────────────────────
# SMTP — Email (opcional)
# ────────────────────────────────────────────────────────────
# Necesario si tu app envia emails (recuperacion de password,
# notificaciones, etc.).

# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@tudominio.com
# SMTP_FROM_NAME=${APP_NAME}


# ────────────────────────────────────────────────────────────
# STORAGE — Archivos persistentes
# ────────────────────────────────────────────────────────────

# Ruta dentro del contenedor (volumen Docker en prod).
STORAGE_PATH=/app/storage

# Tamano maximo de archivos subidos.
MAX_UPLOAD_SIZE=10MB


# ────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────

# Nivel: debug | info | warn | error
LOG_LEVEL=debug

# Formato: json | text. En produccion usar json.
LOG_FORMAT=text

# IMPORTANTE: NUNCA loguear:
# - Passwords / hashes
# - JWTs propios o de terceros
# - MAESTRO_API_KEY, MAESTRO_WEBHOOK_SECRET, JWT_SECRET, SESSION_SECRET
# - SUPERADMIN_INITIAL_PASSWORD
# - Cookies de sesion
# - Bodies de requests con datos sensibles
