# ============================================================================
# Maestro Platform V1 — variables de entorno (plantilla)
# ============================================================================
# Copiar a .env (gitignored) y completar valores.
# En staging/prod, secretos via Docker Secrets (no archivos .env en VPS).
# Fuente única: .env raíz alimenta docker-compose.dev.yml (DEC-025).
# backend/.env NO existe; si aparece, debe eliminarse.
# ============================================================================

# --------- Core Laravel (backend) ---------
APP_NAME=Maestro
APP_ENV=local                           # local | staging | production
APP_KEY=                                # `just key-generate`
APP_DEBUG=true                          # false en staging/production
APP_URL=https://maestro.maestro.local
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es_AR
APP_FALLBACK_LOCALE=es

# --------- Dominio base ---------
MAESTRO_BASE_DOMAIN=maestro.local
MAESTRO_PORTAL_URL=https://maestro.maestro.local

# --------- Base de datos ---------
DB_CONNECTION=pgsql
DB_HOST=maestro-db
DB_PORT=5432
DB_DATABASE=maestro
DB_USERNAME=maestro
DB_PASSWORD=changeme_32_chars_minimo_random
DB_PURGER_USERNAME=maestro_purger
DB_PURGER_PASSWORD=changeme_random

# --------- Redis ---------
REDIS_HOST=maestro-redis
REDIS_PASSWORD=changeme_random
REDIS_PORT=6379
REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --------- Passport OAuth2 v13 ---------
JWT_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_CACHE_TTL_SECONDS=300
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --------- Cifrado AES-256 ---------
MAESTRO_ENCRYPTION_KEY=                 # `just encryption-key`

# --------- Microsoft Entra ID (DEC-026: feature flag) ---------
# Poner MICROSOFT_ENTRA_ENABLED=true solo cuando haya credenciales reales.
MICROSOFT_ENTRA_ENABLED=false
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_REDIRECT_URI=https://maestro.maestro.local/api/auth/microsoft/callback
MICROSOFT_AUTO_PROVISION=false

# --------- Docker socket proxy ---------
DOCKER_PROXY_URL=http://maestro-docker-proxy:2375

# --------- Observabilidad ---------
LOG_CHANNEL=stack
LOG_STACK=stderr,daily
LOG_LEVEL=info
SENTRY_DSN=

# --------- Backups (DEC-027: Azurite en dev, Azure Blob real en prod) ---------
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULE="0 2 * * *"
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_STORAGE_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONTAINER=maestro-backups
AZURE_STORAGE_ENDPOINT=http://azurite:10000/devstoreaccount1

# --------- Rate limiting ---------
RATE_LIMIT_DEFAULT_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_APPS_REGISTER_PER_MIN=100

# --------- Portal (VITE_ públicas, bundleadas en build) ---------
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Maestro
VITE_MICROSOFT_ENTRA_ENABLED=false
