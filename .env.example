# ============================================================
# PLATAFORMA MAESTRO — Variables de Entorno
# ============================================================
# Copiar este archivo a .env y ajustar los valores:
#   cp .env.example .env
#
# NUNCA commitear el archivo .env al repositorio.
# Este archivo (.env.example) SÍ se commitea como referencia.
# ============================================================


# ────────────────────────────────────────────────────────────
# APP — Identificación y puertos
# ────────────────────────────────────────────────────────────

# ID único de la aplicación (coordinar con el administrador).
# Determina los puertos asignados. Ver tabla en README sección 5.
# Fórmula: APP_PORT = 3000 + (APP_ID × 100)
APP_ID=1

# Nombre slug de la app (lowercase, sin espacios, sin caracteres especiales).
# Se usa en nombres de contenedores, redes y volúmenes Docker.
APP_NAME=inventario

# Puerto EXTERNO donde la app es accesible desde el host.
# Calculado automáticamente: 3000 + (APP_ID × 100)
# No cambiar salvo que sepas lo que hacés.
APP_PORT=3100

# Puerto INTERNO que tu app escucha dentro del contenedor.
# Este es el puerto natural de tu framework:
#   Node.js (Express/Fastify/NestJS): 3000
#   Python (FastAPI/Flask/Django):     8000
#   PHP (Laravel):                     8000
#   Java (Spring Boot):                8080
#   Go (Gin/Fiber):                    8080
#   .NET (ASP.NET):                    5000
#   Ruby (Rails):                      3000
#   Rust (Actix):                      8080
APP_INTERNAL_PORT=3000

# Entorno de ejecución
# Opciones: development, staging, production
APP_ENV=development


# ────────────────────────────────────────────────────────────
# DB — Base de datos
# ────────────────────────────────────────────────────────────

# Motor de base de datos.
# Opciones: postgres, mysql, mongo, sqlite, none
# Debe coincidir con maestro.yaml → requires.database
DB_ENGINE=postgres

# Imagen Docker del motor de BD.
# Cambiar según DB_ENGINE:
#   postgres → postgres:16-alpine
#   mysql    → mysql:8.0
#   mongo    → mongo:7
DB_IMAGE=postgres:16-alpine

# Driver para la URL de conexión.
# Cambiar según DB_ENGINE:
#   postgres → postgresql
#   mysql    → mysql
#   mongo    → mongodb
DB_DRIVER=postgresql

# Puerto interno del motor de BD (dentro del contenedor).
# No cambiar salvo que tu imagen use un puerto no estándar.
#   PostgreSQL: 5432
#   MySQL:      3306
#   MongoDB:    27017
DB_PORT_INTERNAL=5432

# Nombre de la base de datos.
DB_NAME=app-inventario

# Usuario de la base de datos.
DB_USER=dev-inventario

# Contraseña de la base de datos.
# En desarrollo puede ser simple. En producción el Maestro genera passwords seguros.
DB_PASSWORD=dev_secret_123

# Exponer el puerto de la BD al host para debug (ej: conectar con DBeaver, pgAdmin).
# true  = expone en el puerto DB_DEBUG_PORT
# false = la BD solo es accesible dentro de la red Docker
DB_EXPOSE_PORT=false

# Puerto del host donde se expone la BD si DB_EXPOSE_PORT=true.
# Calculado: 3000 + (APP_ID × 100) + 1
# Solo se usa en desarrollo para inspeccionar la BD con herramientas externas.
DB_DEBUG_PORT=3101


# ────────────────────────────────────────────────────────────
# MOCK — Simulación de autenticación del Maestro
# ────────────────────────────────────────────────────────────
# El mock inyecta estos valores como headers X-Auth-* en cada request.
# Simula lo que Traefik + Maestro hacen en producción.
# Accedé a tu app vía http://localhost:{MOCK_PORT} para usar el mock.

# Puerto externo del mock de autenticación.
# Calculado: 9000 + (APP_ID × 100)
MOCK_PORT=9100

# ID del usuario simulado (entero como string).
MOCK_USER_ID=1

# Email del usuario simulado.
MOCK_USER_EMAIL=dev@empresa-test.com

# Nombre del usuario simulado (informativo, no se usa en headers estándar).
MOCK_USER_NAME=Desarrollador Test

# ID de la empresa simulada (entero como string).
MOCK_COMPANY_ID=1

# Roles del usuario simulado en esta app.
# Opciones comunes: admin, editor, user, viewer
MOCK_ROLES=admin

# Permisos granulares del usuario simulado (JSON array como string).
MOCK_PERMISSIONS=["read","write","delete","admin"]


# ────────────────────────────────────────────────────────────
# REDIS — Cache y colas (opcional)
# ────────────────────────────────────────────────────────────
# Descomentar si tu app necesita Redis.
# También descomentar el servicio redis en docker-compose.yml.

# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=redis_dev_123


# ────────────────────────────────────────────────────────────
# TAILWISE — Sistema de diseño
# ────────────────────────────────────────────────────────────

# Theme de Tailwise en uso.
# Opciones: dagger, echo, exort, havoc, hook, hurricane, ravage, raze, razor, shuriken, viper
# Consultar con el administrador cuál es el theme oficial de la plataforma.
TAILWISE_THEME=echo

# Versión de Tailwise usada.
# Opciones: "HTML Version - v1.0.1", "Laravel Version - v1.0.3",
#           "React Version - v1.0.9", "Tailwise Vue - v1.0.1"
TAILWISE_VERSION=React Version - v1.0.9


# ────────────────────────────────────────────────────────────
# MAESTRO API — Conexión con la plataforma (producción)
# ────────────────────────────────────────────────────────────
# En desarrollo apunta al mock. En producción el Maestro inyecta el valor real.

# URL base de la API del Maestro.
# En dev: apunta al mock. En prod: lo inyecta el Maestro automáticamente.
MAESTRO_API_URL=http://maestro-mock:80

# ID de instancia asignado por el Maestro.
# En dev: cualquier valor. En prod: lo inyecta el Maestro automáticamente.
MAESTRO_INSTANCE_ID=local-dev

# Slug de la empresa activa.
# En dev: cualquier valor. En prod: lo inyecta el Maestro automáticamente.
APP_COMPANY_SLUG=empresa-test


# ────────────────────────────────────────────────────────────
# SMTP — Email (opcional)
# ────────────────────────────────────────────────────────────
# Descomentar si tu app envía emails.

# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@tudominio.com
# SMTP_FROM_NAME="${APP_NAME}"


# ────────────────────────────────────────────────────────────
# STORAGE — Archivos persistentes
# ────────────────────────────────────────────────────────────

# Ruta dentro del contenedor donde se guardan archivos persistentes.
# Este directorio es un volumen Docker montado por el Maestro en producción.
STORAGE_PATH=/app/storage

# Tamaño máximo de archivos subidos.
MAX_UPLOAD_SIZE=10MB


# ────────────────────────────────────────────────────────────
# LOGGING — Configuración de logs
# ────────────────────────────────────────────────────────────

# Nivel de logging.
# Opciones: debug, info, warn, error
LOG_LEVEL=debug

# Formato de logs.
# Opciones: json, text
# En producción usar json para que el recolector del Maestro los parsee.
LOG_FORMAT=text
