# ============================================================
# .gitignore — repo template Plataforma Maestro v4
# ============================================================
# Excluye archivos sensibles, builds, dependencias y temporales.
# .env.example SI se commitea (referencia); .env y derivados NO.
# ============================================================

# ── Secretos y configs locales ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.kdbx
secrets/
secrets.json
credentials.json
.aws/
.gcp/
.azure/
id_rsa
id_ed25519
*.ppk

# ── Dependencias ──
node_modules/
vendor/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
target/
.gradle/

# ── Builds ──
dist/
build/
out/
*.egg-info/
.next/
.nuxt/
.svelte-kit/

# ── Coverage / tests ──
coverage/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
*.lcov

# ── Logs ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE / OS ──
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Random seed (sistema) ──
.rnd
*.rnd

# ── Tooling local ──
.claude/local/
.claude/settings.local.json

# ── Docker volumes locales ──
.docker-data/

# ── Python / Node temporal ──
*.pid
*.seed
.cache/
.parcel-cache/
.eslintcache

# ── Bases de datos locales ──
*.sqlite
*.sqlite3
*.db

# ── Archivos del editor ──
*.bak
*.tmp
*~
\#*\#
