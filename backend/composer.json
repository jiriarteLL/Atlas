{
    "name": "llyasoc-digital/maestro",
    "type": "project",
    "description": "Maestro Platform V1 — Identity Provider, motor de provisioning y gateway multi-tenant para aplicaciones huésped dockerizadas.",
    "keywords": ["laravel", "maestro", "multi-tenant", "paas", "oauth2"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^13.5",
        "laravel/passport": "^13.7",
        "laravel/socialite": "^5.15",
        "predis/predis": "^2.2",
        "symfony/uid": "^7.2",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "larastan/larastan": "^3.0",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "lint": "pint --test",
        "lint-fix": "pint",
        "analyze": "phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
