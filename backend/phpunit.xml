<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         stopOnFailure="false"
         executionOrder="random"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_KEY" value="base64:Zt8yFLvA7rCv9mdPjvQZ7pEtQYB9gKxQmBQ0AaXnzAE="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="maestro-db"/>
        <env name="DB_DATABASE" value="maestro_test"/>
        <env name="DB_USERNAME" value="maestro"/>
        <env name="DB_PASSWORD" value="changeme"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_HOST" value="maestro-redis"/>
        <env name="REDIS_PASSWORD" value="changeme"/>
        <env name="MAESTRO_BASE_DOMAIN" value="maestro.test"/>
        <!-- DEC-026: flag Entra forzado OFF en tests; cada test del flujo OAuth lo activa localmente. -->
        <env name="MICROSOFT_ENTRA_ENABLED" value="false" force="true"/>
        <!-- DEC-027: Azurite solo corre en dev. En tests, BackupService fallback a disco local. -->
        <env name="AZURE_STORAGE_ACCOUNT" value="" force="true"/>
    </php>
</phpunit>
